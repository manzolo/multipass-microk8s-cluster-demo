###############################################################################
#                    MULTIPASS MICROK8S CLUSTER - CONFIGURATION
###############################################################################
# This file contains all configuration variables for the Kubernetes cluster
# based on MicroK8s with Multipass VMs.
#
# LOADING PRIORITY:
#   1. Values in .env (this file) - project default values
#   2. Values in .env.local - local overrides (not committed to git)
#   3. Environment variables already set in the system
#
# To customize the configuration without modifying this file,
# create/modify the .env.local file with your overrides.
###############################################################################


#==============================================================================
# VM OPERATING SYSTEM CONFIGURATION
#==============================================================================

# Ubuntu version to use for Multipass VMs
# Allowed values: 18.04, 20.04, 22.04, 24.04
#
# Compatibility matrix Ubuntu <-> MicroK8s:
#   Ubuntu 24.04: MicroK8s 1.28 - 1.35+ (recommended)
#   Ubuntu 22.04: MicroK8s 1.25 - 1.35+ (recommended)
#   Ubuntu 20.04: MicroK8s 1.20 - 1.32
#   Ubuntu 18.04: MicroK8s 1.18 - 1.32
#
# Default: 24.04
UBUNTU_VERSION=24.04


#==============================================================================
# MICROK8S CONFIGURATION
#==============================================================================

# MicroK8s version (channel) to install
# To see available versions: snap info microk8s
# Recommended stable versions: 1.30, 1.31, 1.32, 1.35
#
# NOTE: Ensure the version is compatible with UBUNTU_VERSION
# Default: 1.32
MICROK8S_VERSION=1.32


#==============================================================================
# VM RESOURCE CONFIGURATION
#==============================================================================

# Number of worker nodes in the cluster (in addition to the main node)
# Increase this value for larger clusters and better resilience
# Default: 2
#INSTANCES=2

# Number of CPUs for the main VM (k8s-main)
# At least 2 CPUs recommended to handle the control plane
# Default: 2
#MAIN_CPU=2

# Amount of RAM for the main VM
# Format: number followed by unit (Gb, Mb)
# Recommended minimum: 2Gb, optimal: 4Gb+
# Default: 2Gb
#MAIN_RAM=2Gb

# Disk size for the main VM
# Format: number followed by unit (Gb, Mb)
# Recommended: at least 10Gb for container images and persistent storage
# Default: 10Gb
#MAIN_HDD_GB=10Gb


#==============================================================================
# VM NAMES AND HOSTNAMES
#==============================================================================

# Name of the main VM hosting the Kubernetes control plane
# This node manages the API server, scheduler, and controller manager
# Default: k8s-main
VM_MAIN_NAME=k8s-main

# Prefix for worker node VMs
# Nodes will be named: {prefix}1, {prefix}2, etc.
# Example with prefix "k8s-node": k8s-node1, k8s-node2, k8s-node3
# Default: k8s-node
VM_NODE_PREFIX=k8s-node

# Name of the VM hosting the DNS server (dnsmasq)
# Provides DNS resolution for all cluster hostnames
# Default: k8s-dns-server
DNS_VM_NAME=k8s-dns-server

# DNS domain suffix for cluster hostnames
# All hostnames will be: {hostname}.{DNS_SUFFIX}
# Example: rancher.loc, nginx-lb.loc
# Default: loc
DNS_SUFFIX=loc

# NGINX load balancer hostname
# Accessible as: {LOAD_BALANCE_HOSTNAME}.{DNS_SUFFIX}
# Default: nginx-lb
LOAD_BALANCE_HOSTNAME=nginx-lb

# Rancher hostname (cluster management web UI)
# Accessible as: {RANCHER_HOSTNAME}.{DNS_SUFFIX}
# Default: rancher
RANCHER_HOSTNAME=rancher

# Client VM hostname (for external kubectl access)
# Accessible as: {CLIENT_HOSTNAME}.{DNS_SUFFIX}
# Default: k8s-client
CLIENT_HOSTNAME=k8s-client


#==============================================================================
# ADDITIONAL COMPONENT VERSIONS
#==============================================================================

# Rancher version to install
# Rancher provides a web UI for managing the Kubernetes cluster
# See: https://github.com/rancher/rancher/releases for versions
# Default: v2.10.2
RANCHER_VERSION=v2.10.2


#==============================================================================
# ADVANCED CONFIGURATION
#==============================================================================

# Template name for cloning worker nodes
# Used internally to speed up node creation
# Default: template-node-cluster
#NODE_TEMPLATE=template-node-cluster

# Force VM stop instead of graceful shutdown
# true = use 'multipass stop --force' (faster but less safe)
# false = use normal 'multipass stop' (slower but safer)
# Default: false
FORCE_STOP_VM=false


#==============================================================================
# AUTOMATIC APPLICATION STACK DEPLOYMENT
#==============================================================================
# These variables control which stacks are automatically deployed
# during cluster creation (./create_kube_vms.sh).
#
# Values: true = auto deploy, false = do not deploy
#
# NOTE: You can always manually deploy stacks from the interactive
#       menu (./menu.sh) even if set to false here.
#==============================================================================

#------------------------------------------------------------------------------
# DEMO APPLICATIONS
#------------------------------------------------------------------------------

# Demo Go - Sample Go application
# Useful for testing cluster functionality
# Default: false
#DEPLOY_DEMO_GO=false

# Demo PHP - Sample PHP application
# Useful for testing cluster functionality
# Default: false
#DEPLOY_DEMO_PHP=false

# Static Site - Static website served by NGINX
# Example of static content hosting
# Default: false
#DEPLOY_STATIC_SITE=false

#------------------------------------------------------------------------------
# DATABASES
#------------------------------------------------------------------------------

# MariaDB - MySQL-compatible relational database
# Ideal for traditional web applications
# Default: false
#DEPLOY_MARIADB=false

# PostgreSQL - Advanced relational database
# Great for enterprise applications
# Default: false
#DEPLOY_POSTGRES=false

# MongoDB - Document-oriented NoSQL database
# Perfect for unstructured data and high scalability
# Default: false
#DEPLOY_MONGODB=false

# Redis - In-memory database / cache
# Used for caching, sessions, and queues
# Default: false
#DEPLOY_REDIS=false

#------------------------------------------------------------------------------
# MESSAGING / QUEUES
#------------------------------------------------------------------------------

# RabbitMQ - AMQP message broker
# For event-driven architectures and microservices
# Default: false
#DEPLOY_RABBITMQ=false

#------------------------------------------------------------------------------
# MONITORING / LOGGING
#------------------------------------------------------------------------------

# ELK Stack (Elasticsearch + Kibana)
# Complete stack for logging and analysis
# WARNING: Requires significant resources (at least 4Gb RAM)
# Default: false
#DEPLOY_ELK=false

#------------------------------------------------------------------------------
# CI/CD
#------------------------------------------------------------------------------

# Jenkins - CI/CD server
# For automated build and deployment pipelines
# Default: false
#DEPLOY_JENKINS=false


###############################################################################
# END OF CONFIGURATION
###############################################################################
# To apply changes:
#   - For new cluster: ./create_kube_vms.sh
#   - For existing cluster: use ./menu.sh to manage stacks
###############################################################################
