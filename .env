# Override the default Ubuntu version
# Allowed versions: 18.04, 20.04, 22.04, 24.04
#
# Compatibility matrix (Ubuntu <-> MicroK8s):
#   Ubuntu 24.04: MicroK8s 1.28 - 1.35+ (recommended)
#   Ubuntu 22.04: MicroK8s 1.25 - 1.35+ (recommended)
#   Ubuntu 20.04: MicroK8s 1.20 - 1.32
#   Ubuntu 18.04: MicroK8s 1.18 - 1.32
#
UBUNTU_VERSION=18.04

# MicroK8s version (channel)
# See available versions: snap info microk8s
# Recommended stable versions: 1.30, 1.31, 1.32
MICROK8S_VERSION=1.32
# Override the number of instances nodes
#INSTANCES=2
# Override VM CPU count
#MAIN_CPU=1
# Override main VM RAM
#MAIN_RAM=4Gb
# Override main VM HDD
#MAIN_HDD_GB=20Gb
VM_MAIN_NAME=k8s-main
VM_NODE_PREFIX=k8s-node
DNS_VM_NAME=k8s-dns-server
DNS_SUFFIX=loc
RANCHER_VERSION=v2.10.2
LOAD_BALANCE_HOSTNAME=nginx-lb
RANCHER_HOSTNAME=rancher
CLIENT_HOSTNAME=k8s-client
FORCE_STOP_VM=false

