#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Carica le funzioni comuni se disponibili
if [[ -f "$SCRIPT_DIR/script/functions/common.sh" ]]; then
    # shellcheck source=script/functions/common.sh
    source "$SCRIPT_DIR/script/functions/common.sh"
else
    # Fallback se common.sh non è disponibile
    msg_info() { echo -e "\033[0;32m$1\033[0m"; }
    msg_warn() { echo -e "\033[0;33m$1\033[0m"; }
    msg_error() { echo -e "\033[0;31m$1\033[0m"; }
    msg_fatal() { echo -e "\033[0;31m$1\033[0m"; exit 1; }
fi

show_help() {
    cat << EOF
Uso: $(basename "$0") [OPZIONE] [TIPO]

Crea una nuova release usando git-flow con versionamento semantico.

TIPO (default: patch):
  patch       Incrementa il numero di patch (x.y.Z)
  minor       Incrementa il numero minor e azzera patch (x.Y.0)
  major       Incrementa il numero major e azzera minor e patch (X.0.0)

OPZIONI:
  -h, --help  Mostra questo messaggio di aiuto
  -y, --yes   Non chiedere conferma prima di ogni comando
  -d, --dry-run  Mostra i comandi senza eseguirli

Esempi:
  $(basename "$0")           # Incrementa patch: 1.2.3 -> 1.2.4
  $(basename "$0") patch     # Incrementa patch: 1.2.3 -> 1.2.4
  $(basename "$0") minor     # Incrementa minor: 1.2.3 -> 1.3.0
  $(basename "$0") major     # Incrementa major: 1.2.3 -> 2.0.0
  $(basename "$0") -y minor  # Minor release senza conferme
EOF
}

# Opzioni di default
RELEASE_TYPE="patch"
AUTO_CONFIRM=false
DRY_RUN=false

# Parse degli argomenti
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -y|--yes)
            AUTO_CONFIRM=true
            shift
            ;;
        -d|--dry-run)
            DRY_RUN=true
            shift
            ;;
        patch|minor|major)
            RELEASE_TYPE="$1"
            shift
            ;;
        *)
            msg_error "Opzione non riconosciuta: $1"
            show_help
            exit 1
            ;;
    esac
done

# Verifica se git è installato
if ! command -v git &> /dev/null; then
    msg_fatal "git non è installato"
fi

# Verifica se git-flow è installato
if ! command -v git-flow &> /dev/null; then
    msg_fatal "git-flow non è installato"
fi

# Verifica di essere in un repository git
if ! git rev-parse --is-inside-work-tree &> /dev/null; then
    msg_fatal "Non sei in un repository git"
fi

# Ottieni l'ultimo tag
last_tag=$(git describe --tags --abbrev=0 2>/dev/null) || true

# Verifica se è stato trovato un tag
if [[ -z "$last_tag" ]]; then
    msg_fatal "Nessun tag trovato nel repository."
fi

# Analizza il tag per estrarre i numeri di versione
IFS='.' read -r major minor patch <<< "$last_tag"

# Verifica se il tag è in formato semantico valido (major.minor.patch)
if [[ -z "$major" ]] || [[ -z "$minor" ]] || [[ -z "$patch" ]]; then
    msg_fatal "Il tag '$last_tag' non è in un formato semantico valido (major.minor.patch)."
fi

# Rimuovi eventuali caratteri non numerici dal major (es. 'v' prefix)
major="${major#v}"

if ! [[ "$major" =~ ^[0-9]+$ ]] || ! [[ "$minor" =~ ^[0-9]+$ ]] || ! [[ "$patch" =~ ^[0-9]+$ ]]; then
    msg_fatal "Il tag '$last_tag' non è in un formato semantico valido (major.minor.patch)."
fi

# Calcola la nuova versione in base al tipo di release
case "$RELEASE_TYPE" in
    patch)
        new_major="$major"
        new_minor="$minor"
        new_patch=$((patch + 1))
        ;;
    minor)
        new_major="$major"
        new_minor=$((minor + 1))
        new_patch=0
        ;;
    major)
        new_major=$((major + 1))
        new_minor=0
        new_patch=0
        ;;
esac

new_version="$new_major.$new_minor.$new_patch"

msg_info "Versione attuale: $last_tag"
msg_info "Nuova versione:   $new_version (tipo: $RELEASE_TYPE)"
echo ""

run_command() {
    local cmd="$1"
    echo ""
    msg_warn "Comando: $cmd"

    if [[ "$DRY_RUN" == true ]]; then
        msg_info "[DRY-RUN] Comando non eseguito"
        return 0
    fi

    if [[ "$AUTO_CONFIRM" != true ]]; then
        read -n 1 -s -r -p "Premi un tasto per continuare (CTRL+C per annullare)..."
        echo ""
    fi

    eval "$cmd"
}

run_command "git flow release start '$new_version'"
run_command "git flow release finish '$new_version'"
run_command "git push origin main --tags"

echo ""
msg_info "Versione $new_version rilasciata con successo!"
